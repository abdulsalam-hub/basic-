rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Admin-only collection-group access for review moderation.
    match /{path=**}/reviews/{reviewId} {
      allow read: if isAdmin();
    }

    match /businesses/{businessId} {
      // Public visitors may read approved listings; administrators may read all business records.
      allow get, list: if resource.data.status == 'approved' || isAdmin();
      allow create, update, delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if isAdmin() || (
          resource.data.status == 'approved' &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'approved'
        );

        allow create: if request.auth != null &&
          request.auth.uid == reviewId &&
          !exists(/databases/$(database)/documents/businesses/$(businessId)/reviews/$(reviewId)) &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.status == 'approved' &&
          request.resource.data.keys().hasOnly([
            'uid', 'businessId', 'businessName', 'reviewerName',
            'rating', 'comment', 'status', 'createdAt'
          ]) &&
          request.resource.data.keys().hasAll([
            'uid', 'businessId', 'businessName', 'reviewerName',
            'rating', 'comment', 'status', 'createdAt'
          ]) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.businessId == businessId &&
          request.resource.data.businessName is string &&
          request.resource.data.businessName.size() >= 2 &&
          request.resource.data.businessName.size() <= 100 &&
          request.resource.data.reviewerName is string &&
          request.resource.data.reviewerName.size() >= 1 &&
          request.resource.data.reviewerName.size() <= 60 &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() >= 10 &&
          request.resource.data.comment.size() <= 700 &&
          request.resource.data.status == 'pending' &&
          request.resource.data.createdAt is timestamp;

        allow update: if isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'reviewedAt', 'reviewedBy'
          ]) &&
          request.resource.data.status in ['approved', 'rejected'];

        allow delete: if isAdmin();
      }
    }



    match /businessVerificationRequests/{requestId} {
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'reporterUid', 'businessId', 'businessName', 'requesterName',
          'relationship', 'contactPhone', 'evidence', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'reporterUid', 'businessId', 'businessName', 'requesterName',
          'relationship', 'contactPhone', 'evidence', 'status', 'createdAt'
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.businessId is string &&
        request.resource.data.businessId.size() >= 1 &&
        request.resource.data.businessId.size() <= 128 &&
        get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.status == 'approved' &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() >= 2 &&
        request.resource.data.businessName.size() <= 100 &&
        request.resource.data.requesterName is string &&
        request.resource.data.requesterName.size() >= 2 &&
        request.resource.data.requesterName.size() <= 80 &&
        request.resource.data.relationship in [
          'Business owner', 'Director / partner', 'Authorised employee', 'Family representative'
        ] &&
        request.resource.data.contactPhone is string &&
        request.resource.data.contactPhone.size() >= 7 &&
        request.resource.data.contactPhone.size() <= 25 &&
        request.resource.data.evidence is string &&
        request.resource.data.evidence.size() >= 20 &&
        request.resource.data.evidence.size() <= 500 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp;

      allow read: if isAdmin();

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy'
        ]) &&
        request.resource.data.status in ['verified', 'rejected'];

      allow delete: if isAdmin();
    }

    match /listingReports/{reportId} {
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly([
          'reporterUid', 'businessId', 'businessName', 'reason', 'details', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'reporterUid', 'businessId', 'businessName', 'reason', 'details', 'status', 'createdAt'
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.businessId is string &&
        request.resource.data.businessId.size() >= 1 &&
        request.resource.data.businessId.size() <= 128 &&
        get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.status == 'approved' &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() >= 2 &&
        request.resource.data.businessName.size() <= 100 &&
        request.resource.data.reason in [
          'Incorrect business information',
          'Business appears to be closed',
          'Fake or impersonating business',
          'Misleading products or services',
          'Inappropriate or suspicious content',
          'Other concern'
        ] &&
        request.resource.data.details is string &&
        request.resource.data.details.size() >= 10 &&
        request.resource.data.details.size() <= 700 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp;

      allow read: if isAdmin();

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy'
        ]) &&
        request.resource.data.status in ['reviewed', 'dismissed'];

      allow delete: if isAdmin();
    }

    match /sellerSubmissions/{submissionId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'businessName', 'ownerName', 'category', 'city', 'description', 'whatsapp',
          'status', 'source', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'businessName', 'ownerName', 'category', 'city', 'description', 'whatsapp',
          'status', 'source', 'createdAt'
        ]) &&
        request.resource.data.businessName is string &&
        request.resource.data.businessName.size() >= 2 &&
        request.resource.data.businessName.size() <= 100 &&
        request.resource.data.ownerName is string &&
        request.resource.data.ownerName.size() >= 2 &&
        request.resource.data.ownerName.size() <= 100 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() >= 2 &&
        request.resource.data.category.size() <= 60 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() >= 2 &&
        request.resource.data.city.size() <= 80 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 20 &&
        request.resource.data.description.size() <= 600 &&
        request.resource.data.whatsapp is string &&
        request.resource.data.whatsapp.size() >= 7 &&
        request.resource.data.whatsapp.size() <= 25 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'website' &&
        request.resource.data.createdAt is timestamp;

      allow read: if isAdmin();

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy', 'rejectionReason'
        ]) &&
        request.resource.data.status in ['approved', 'rejected'];

      allow delete: if isAdmin();
    }
  }
}